# === Walidator e-mail PoC v2 — przyklad konfiguracji ===
# Skopiuj do .env i dostosuj. Wszystkie wartosci maja sensowne domyslne.

# --- Polityka blokowania (§8): result -> tryb (hard|conditional|warn|none) ---
# hard        = twardy blok (block_save=true, bez override)
# conditional = blok z checkboxem "potwierdzam recznie" (block_save=true, override)
# warn        = tylko ostrzezenie (block_save=false)
# none        = brak blokady
POLICY_SYNTAX_INVALID=hard
POLICY_DOMAIN_NOT_FOUND=conditional
POLICY_NO_MAIL_CAPABILITY=conditional
POLICY_TYPO_SUSPECTED=warn
POLICY_DISPOSABLE=warn
POLICY_MAILBOX_NOT_FOUND=warn
POLICY_UNKNOWN=none
POLICY_VALID=none

# --- DNS / cache ---
DNS_TIMEOUT_S=1.5
DNS_LIFETIME_S=2.0
CACHE_TTL_S=21600
CACHE_MAXSIZE=10000
# Wlasny/firmowy resolver (opcjonalnie), np. 10.0.0.53,10.0.0.54
DNS_NAMESERVERS=

# --- L1 typo ---
TYPO_MAX_DISTANCE=2

# --- L6 double opt-in ---
VERIFY_TTL_S=86400
VERIFY_BASE_URL=http://localhost:8000
# Store tokenow: sqlite (trwaly, przetrwa restart) lub memory (gubi po restarcie).
VERIFY_STORE=sqlite
VERIFY_DB_PATH=verify.db
# Branding maila i stron potwierdzenia:
VERIFY_COMPANY_NAME=Nasza firma
VERIFY_SUBJECT=Potwierdz swoj adres e-mail
VERIFY_LOGO_URL=
# Limit wysylek na adres (0 = bez limitu):
VERIFY_RATE_MAX=3
VERIFY_RATE_WINDOW_S=3600

# --- SMTP relay (dla L6) ---
# Zostaw SMTP_HOST puste, aby dzialal tryb dry-run (link w logach).
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_STARTTLS=false
# SMTP_DRY_RUN=true  # wymus dry-run nawet gdy SMTP_HOST ustawione

# --- Ogolne ---
CORS_ORIGINS=*
LOG_FULL_EMAIL=false
