# === Walidator e-mail PoC v2 — przyklad konfiguracji ===
# Skopiuj do .env i dostosuj. Wszystkie wartosci maja sensowne domyslne.

# --- Polityka blokowania (§8): result -> tryb (hard|conditional|warn|none) ---
# hard        = twardy blok (block_save=true, bez override)
# conditional = blok z checkboxem "potwierdzam recznie" (block_save=true, override)
# warn        = tylko ostrzezenie (block_save=false)
# none        = brak blokady
POLICY_SYNTAX_INVALID=hard
POLICY_DOMAIN_NOT_FOUND=conditional
POLICY_NO_MAIL_CAPABILITY=conditional
POLICY_TYPO_SUSPECTED=warn
POLICY_DISPOSABLE=warn
POLICY_MAILBOX_NOT_FOUND=warn
POLICY_UNKNOWN=none
POLICY_VALID=none

# --- DNS / cache ---
DNS_TIMEOUT_S=1.5
DNS_LIFETIME_S=2.0
CACHE_TTL_S=21600
CACHE_MAXSIZE=10000
# Wlasny/firmowy resolver (opcjonalnie), np. 10.0.0.53,10.0.0.54
DNS_NAMESERVERS=

# --- L1 typo ---
TYPO_MAX_DISTANCE=2

# --- CRM lookup (opcjonalne, MySQL/MariaDB) ---
# Sprawdza, czy adres juz istnieje w bazie CRM (deduplikacja). Wynik jest tylko
# informacyjny (pole exists_in_crm w odpowiedzi) - NIE blokuje zapisu.
# Zostaw CRM_CHECK_ENABLED=false, aby /validate dzialalo jak dotad (bez bazy).
CRM_CHECK_ENABLED=false
CRM_DB_HOST=
CRM_DB_PORT=3306
CRM_DB_USER=
CRM_DB_PASSWORD=
CRM_DB_NAME=
CRM_DB_TIMEOUT_S=2
# Zapytanie MUSI miec dokladnie jeden placeholder %s (adres, lowercased).
# >=1 wiersz => adres istnieje. Dostosuj tabele/kolumne do swojego schematu CRM:
CRM_QUERY=SELECT 1 FROM contacts WHERE email = %s LIMIT 1

# --- Zgodnosc imie/nazwisko <-> adres (heurystyka + opcjonalne AI) -----------
# Heurystyka jest zawsze dostepna i dziala tylko gdy front poda pole 'name'.
# Nie blokuje zapisu - to sygnal informacyjny (pola name_email_match / name_suggestion).
NAME_MATCH_ENABLED=true
NAME_MATCH_MIN_RATIO=0.85

# Opcjonalne dopracowanie werdyktu WLASNYM modelem AI (OpenAI-compatible).
# Wlacz przelacznikiem 'ai' w panelu /admin (albo AI_ENABLED=true jako domyslne).
AI_ENABLED=false
AI_BASE_URL=            # np. http://twoj-llm:8000/v1
AI_MODEL=              # np. nasz-model-7b
AI_API_KEY=
AI_TIMEOUT_S=4

# --- Panel administracyjny (/admin) + runtime toggles ------------------------
# Jesli ustawisz ADMIN_TOKEN, panel i /admin/settings wymagaja naglowka
# X-Admin-Token. Puste = otwarte (tylko PoC/dev).
ADMIN_TOKEN=
# Plik z utrwalonymi przelacznikami AI/CRM ustawianymi z panelu.
RUNTIME_SETTINGS_PATH=runtime_settings.json

# --- Ogolne ---
CORS_ORIGINS=*
LOG_FULL_EMAIL=false

# --- Walidacja wsadowa CSV (POST /validate/csv, GET /batch) ------------------
# BATCH_MAX_ROWS=5000              # ile wierszy przetwarzamy z jednego pliku
# BATCH_MAX_BYTES=5242880          # limit rozmiaru wgranego pliku (5 MB)
# BATCH_MAX_WORKERS=8              # rownoleglosc zapytan DNS przy batchu
